{
  "name": "@strav/publish",
  "version": "0.4.29",
  "type": "module",
  "description": "Unified multi-channel publisher for the Strav framework — Google Business Profile, Meta (Facebook + Instagram), WordPress, and LINE OA broadcasts behind a single Publisher interface with per-tenant OAuth credentials and auto-refresh",
  "license": "MIT",
  "keywords": [
    "bun",
    "framework",
    "typescript",
    "strav",
    "publishing",
    "google-business-profile",
    "facebook",
    "instagram",
    "wordpress",
    "line",
    "oauth",
    "multi-tenant"
  ],
  "files": [
    "src/",
    "stubs/",
    "package.json",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./credentials": "./src/credentials/index.ts",
    "./credentials/*": "./src/credentials/*.ts",
    "./publishers": "./src/publishers/index.ts",
    "./publishers/*": "./src/publishers/*.ts",
    "./oauth": "./src/oauth/index.ts",
    "./oauth/*": "./src/oauth/*.ts",
    "./providers": "./src/providers/index.ts",
    "./providers/*": "./src/providers/*.ts"
  },
  "peerDependencies": {
    "@strav/kernel": "workspace:*",
    "@strav/database": "workspace:*",
    "@strav/http": "workspace:*",
    "@strav/line": "workspace:*"
  },
  "scripts": {
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit"
  }
}

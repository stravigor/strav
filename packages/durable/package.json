{
  "name": "@strav/durable",
  "version": "0.4.31",
  "type": "module",
  "description": "Durable, crash-resumable workflow execution for the Strav framework",
  "license": "MIT",
  "keywords": [
    "bun",
    "framework",
    "typescript",
    "strav",
    "durable",
    "workflow",
    "orchestration"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine/index.ts",
    "./engine/*": "./src/engine/*.ts",
    "./models": "./src/models/index.ts",
    "./models/*": "./src/models/*.ts",
    "./providers": "./src/providers/index.ts",
    "./providers/*": "./src/providers/*.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "src/",
    "package.json",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@strav/kernel": "workspace:*",
    "@strav/database": "workspace:*"
  },
  "dependencies": {
    "@strav/queue": "workspace:*",
    "@strav/machine": "workspace:*",
    "@strav/workflow": "workspace:*",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1"
  },
  "scripts": {
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit"
  }
}
